# Copia estas variables en Vercel → Project → Settings → Environment Variables.
# Nunca subas los valores reales al repositorio.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...            # clave pública (anon / publishable)
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # clave secreta: solo en el servidor

# Anthropic Console → API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Solo si la clave es de organización y la API pide un workspace (empieza por wrkspc_)
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Opcional: Google Drive (selector de archivos). Ver docs/DESPLIEGUE.md
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_API_KEY=AIza...
# GOOGLE_APP_ID=123456789012        # número del proyecto de Google Cloud

# Opcionales
LUMEN_DAILY_AI_LIMIT=120            # llamadas a la IA por persona y día
# LUMEN_MODEL=claude-opus-5-5       # modelo de Claude
